<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike Q1: hosting IEmptyVolumeCache handlers from our own process. Read-only. Not part of Spacewise.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- SYSLIB1096: suggestion to use GeneratedComInterface; classic ComImport is deliberate for a spike. -->
    <NoWarn>$(NoWarn);SYSLIB1096</NoWarn>
  </PropertyGroup>

</Project>
