<UserControl x:Class="Spacewise.Desktop.Views.UsageView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible" /></UserControl.Resources>

        <DockPanel Margin="18">
          <ScrollViewer DockPanel.Dock="Top" MaxHeight="144" Margin="0,0,0,8" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <WrapPanel>
              <Button Content="{DynamicResource Ui.047}"
                      Style="{StaticResource PrimaryButton}"
                      IsEnabled="{Binding IsIdle}"
                      Command="{Binding LoadUsageCommand}" />
              <Button Content="{DynamicResource Ui.048}"
                      Margin="8,0,0,0"
                      Command="{Binding EraseHistoryCommand}" />
              <Button Content="{DynamicResource Programs.Uninstall}"
                      Margin="8,0,0,0"
                      Style="{StaticResource DestructiveButton}"
                      Command="{Binding UninstallProgramCommand}" />
              <Button Content="{DynamicResource Programs.StopSearch}" Command="{Binding UninstallProgramCancelCommand}"
                      Visibility="{Binding IsSearchingRemnants, Converter={StaticResource Visible}}" Margin="8,0,0,0" />
            </WrapPanel>
            <TextBlock Text="{Binding UsageStatus}"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding UsageSummary}"
                       Margin="0,4,0,0"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding ProgramActionStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          </ScrollViewer>
          <Expander x:Name="RemnantsPanel" DockPanel.Dock="Bottom" Header="{DynamicResource Programs.RemnantsTitle}" Margin="0,8,0,0">
            <ScrollViewer MaxHeight="155" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <DataGrid ItemsSource="{Binding ProgramRemnants}" SelectedItem="{Binding SelectedRemnant}" Height="90" IsReadOnly="True" AutoGenerateColumns="False"
                        CanUserAddRows="False" AutomationProperties.Name="{DynamicResource Programs.RemnantsTitle}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource Programs.Path}" Binding="{Binding Path, Mode=OneWay}" Width="*" MinWidth="280">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="ToolTip" Value="{Binding Path}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="{DynamicResource Ui.022}" Binding="{Binding Size, Mode=OneWay}" Width="110" />
                  <DataGridTextColumn Header="{DynamicResource Programs.Availability}" Binding="{Binding Availability, Mode=OneWay}" Width="120" />
                </DataGrid.Columns>
              </DataGrid>
              <WrapPanel Margin="0,4,0,0">
                <Button Content="{DynamicResource Programs.RemoveFile}" Command="{Binding RemoveRemnantCommand}"
                        Style="{StaticResource DestructiveButton}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource Programs.Explain}" Command="{Binding ExplainRemnantsCommand}" IsEnabled="{Binding IsIdle}" />
                <Button Content="{DynamicResource AI.CancelAnalysis}" Command="{Binding ExplainRemnantsCancelCommand}" Margin="8,0,0,0" />
              </WrapPanel>
              <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding RemnantAdvice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              </ScrollViewer>
            </StackPanel>
            </ScrollViewer>
          </Expander>
          <DataGrid ItemsSource="{Binding UsageRows}"
                    SelectedItem="{Binding SelectedProgram}"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    EnableRowVirtualization="True"
                    AutomationProperties.Name="{DynamicResource Ui.049}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource Ui.050}" Binding="{Binding Name, Mode=OneWay}" Width="220" />
              <DataGridTextColumn Header="{DynamicResource Ui.051}" Binding="{Binding Kind, Mode=OneWay}" Width="100" />
              <DataGridTextColumn Header="{DynamicResource Ui.022}" Binding="{Binding SizeText, Mode=OneWay}" Width="110" />
              <DataGridTextColumn Header="{DynamicResource Ui.046}" Binding="{Binding Status, Mode=OneWay}" Width="*" MinWidth="200" />
              <DataGridTextColumn Header="{DynamicResource Ui.052}" Binding="{Binding Evidence, Mode=OneWay}" Width="220" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>

</UserControl>
