<Window x:Class="Spacewise.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Spacewise — только анализ" Width="1100" Height="740" MinWidth="960" MinHeight="640" FontFamily="Segoe UI" FontSize="14" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Обзор пространства" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Метаданные локальной папки. Файлы не удаляются, содержимое не читается." Margin="0,8,0,16" TextWrapping="Wrap"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RootPath" MinHeight="40" VerticalContentAlignment="Center" AutomationProperties.Name="Папка для анализа"/><Button Grid.Column="1" x:Name="BrowseButton" Content="Выбрать папку…" Margin="8,0,0,0" Padding="16,8" Click="Browse_Click"/></Grid>
    <StackPanel Grid.Row="2" Margin="0,12,0,12"><Label Content="Исключения: по одному абсолютному пути в строке; регистр не учитывается" Target="{Binding ElementName=Exclusions}"/><TextBox x:Name="Exclusions" Height="56" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Исключения"/></StackPanel>
    <StackPanel Grid.Row="3" Margin="0,0,0,16"><StackPanel Orientation="Horizontal"><Button x:Name="ScanButton" Content="Начать анализ" Padding="20,10" Click="Scan_Click"/><Button x:Name="CancelButton" Content="Остановить" IsEnabled="False" Padding="20,10" Margin="8,0,0,0" Click="Cancel_Click"/></StackPanel><TextBlock x:Name="Status" Margin="0,12,0,0" Text="Готов к проверке" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><ProgressBar x:Name="Busy" Height="3" Margin="0,8,0,0" Visibility="Collapsed" IsIndeterminate="True"/></StackPanel>
    <DataGrid Grid.Row="4" x:Name="Files" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" AutomationProperties.Name="До ста крупнейших файлов"><DataGrid.Columns><DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="110"/><DataGridTextColumn Header="На диске" Binding="{Binding OnDisk}" Width="110"/><DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="220"/></DataGrid.Columns></DataGrid>
    <TextBox Grid.Row="5" x:Name="Details" Height="92" Margin="0,16,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" AutomationProperties.Name="Ограничения и ошибки" Text="Объём — сумма логических размеров записей; hard links могут учитываться повторно. Место на диске и число ссылок известны только для ста крупнейших файлов. Освобождаемое место не измеряется. Ссылки и облачные placeholders пропускаются. Модель отключена. Это каркас, а не готовый очиститель."/>
  </Grid>
</Window>
