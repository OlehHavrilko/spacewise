<Window x:Class="Spacewise.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Spacewise.Desktop" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:MainViewModel}" Title="Spacewise — только анализ" Width="1100" Height="740" MinWidth="960" MinHeight="640" FontFamily="Segoe UI" FontSize="14" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
  <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/></Window.Resources>
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Обзор пространства" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Метаданные локальной папки. Файлы не удаляются, содержимое не читается." Margin="0,8,0,16" TextWrapping="Wrap"/></StackPanel>
    <Grid Grid.Row="1" IsEnabled="{Binding IsIdle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RootPath" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" VerticalContentAlignment="Center" AutomationProperties.Name="Папка для анализа"/><Button Grid.Column="1" Content="Выбрать папку…" Margin="8,0,0,0" Padding="16,8" Click="Browse_Click"/></Grid>
    <StackPanel Grid.Row="2" Margin="0,12,0,12" IsEnabled="{Binding IsIdle}"><Label Content="Исключения: по одному абсолютному пути в строке; регистр не учитывается" Target="{Binding ElementName=Exclusions}"/><TextBox x:Name="Exclusions" Text="{Binding ExclusionsText, UpdateSourceTrigger=PropertyChanged}" Height="56" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Исключения"/></StackPanel>
    <StackPanel Grid.Row="3" Margin="0,0,0,16"><StackPanel Orientation="Horizontal"><Button Content="Начать анализ" Padding="20,10" Command="{Binding ScanCommand}"/><Button Content="Остановить" Padding="20,10" Margin="8,0,0,0" Command="{Binding ScanCancelCommand}"/></StackPanel><TextBlock Text="{Binding Status}" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><ProgressBar Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" IsIndeterminate="True"/></StackPanel>
    <DataGrid Grid.Row="4" ItemsSource="{Binding Files}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" AutomationProperties.Name="До ста крупнейших файлов"><DataGrid.Columns><DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="110"/><DataGridTextColumn Header="На диске" Binding="{Binding OnDisk}" Width="110"/><DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="220"/></DataGrid.Columns></DataGrid>
    <TextBox Grid.Row="5" Text="{Binding Details, Mode=OneWay}" Height="92" Margin="0,16,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" AutomationProperties.Name="Ограничения и ошибки"/>
  </Grid>
</Window>
