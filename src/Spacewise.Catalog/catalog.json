{
  "version": 2,
  "rules": [
    {
      "id": "windows.user.temp",
      "ruleVersion": 1,
      "title_ru": "Временные файлы пользователя",
      "detect": { "anyPath": ["%TEMP%"] },
      "targets": [{ "root": "%TEMP%", "include": ["**"], "minAgeDays": 1 }],
      "action": "delete",
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Удаляются файлы старше суток; занятые файлы пропускаются.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["user-temp"]
    },
    {
      "id": "windows.system.temp",
      "ruleVersion": 1,
      "title_ru": "Временные файлы Windows",
      "detect": { "anyPath": ["%SYSTEMROOT%\\Temp"] },
      "targets": [{ "root": "%SYSTEMROOT%\\Temp", "include": ["**"], "minAgeDays": 7 }],
      "action": "delete",
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": true,
      "automationEligible": false,
      "sideEffects_ru": "Удаляются файлы старше недели. Нужны права администратора.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["system-temp"]
    },
    {
      "id": "browser.chromium.chrome.cache",
      "ruleVersion": 1,
      "title_ru": "Кэш Google Chrome",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\Google\\Chrome\\User Data"] },
      "profiles": { "root": "%LOCALAPPDATA%\\Google\\Chrome\\User Data", "include": ["Default", "Profile *"] },
      "targets": [{ "root": "{profile}", "include": ["Cache\\Cache_Data\\**", "Code Cache\\**", "GPUCache\\**"] }],
      "action": "delete",
      "runningProcess": ["chrome.exe"],
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Браузер создаст кэш заново; первые загрузки сайтов будут дольше.",
      "verifiedOn": { "os": ["10.0.26300"], "app": ">=120" },
      "fixtures": ["chromium-profile"]
    },
    {
      "id": "browser.chromium.edge.cache",
      "ruleVersion": 1,
      "title_ru": "Кэш Microsoft Edge",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\Microsoft\\Edge\\User Data"] },
      "profiles": { "root": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data", "include": ["Default", "Profile *"] },
      "targets": [{ "root": "{profile}", "include": ["Cache\\Cache_Data\\**", "Code Cache\\**", "GPUCache\\**"] }],
      "action": "delete",
      "runningProcess": ["msedge.exe"],
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Браузер создаст кэш заново; первые загрузки сайтов будут дольше.",
      "verifiedOn": { "os": ["10.0.26300"], "app": ">=120" },
      "fixtures": ["edge-profile"]
    },
    {
      "id": "browser.chromium.brave.cache",
      "ruleVersion": 1,
      "title_ru": "Кэш Brave",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data"] },
      "profiles": { "root": "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data", "include": ["Default", "Profile *"] },
      "targets": [{ "root": "{profile}", "include": ["Cache\\Cache_Data\\**", "Code Cache\\**", "GPUCache\\**"] }],
      "action": "delete",
      "runningProcess": ["brave.exe"],
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Браузер создаст кэш заново; первые загрузки сайтов будут дольше.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["brave-profile"]
    },
    {
      "id": "browser.firefox.cache",
      "ruleVersion": 1,
      "title_ru": "Кэш Firefox",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles"] },
      "profiles": { "root": "%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles", "include": ["*"] },
      "targets": [{ "root": "{profile}", "include": ["cache2\\**", "startupCache\\**"] }],
      "action": "delete",
      "runningProcess": ["firefox.exe"],
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Браузер создаст кэш заново; закладки, пароли и история не затрагиваются.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["firefox-profile"]
    },
    {
      "id": "electron.discord.cache",
      "ruleVersion": 1,
      "title_ru": "Кэш Discord",
      "detect": { "anyPath": ["%APPDATA%\\discord"] },
      "targets": [{ "root": "%APPDATA%\\discord", "include": ["Cache\\**", "Code Cache\\**", "GPUCache\\**"] }],
      "action": "delete",
      "runningProcess": ["Discord.exe"],
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Картинки и вложения загрузятся заново; вход и настройки сохраняются.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["discord"]
    },
    {
      "id": "electron.vscode.cache",
      "ruleVersion": 1,
      "title_ru": "Кэш Visual Studio Code",
      "detect": { "anyPath": ["%APPDATA%\\Code"] },
      "targets": [{ "root": "%APPDATA%\\Code", "include": ["Cache\\**", "CachedData\\**", "Code Cache\\**", "GPUCache\\**"] }],
      "action": "delete",
      "runningProcess": ["Code.exe"],
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Первый запуск после очистки будет медленнее; расширения и настройки не затрагиваются.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["vscode"]
    },
    {
      "id": "electron.slack.cache",
      "ruleVersion": 1,
      "title_ru": "Кэш Slack",
      "detect": { "anyPath": ["%APPDATA%\\Slack"] },
      "targets": [{ "root": "%APPDATA%\\Slack", "include": ["Cache\\**", "Code Cache\\**", "GPUCache\\**", "Service Worker\\CacheStorage\\**"] }],
      "action": "delete",
      "runningProcess": ["slack.exe"],
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Картинки и файлы загрузятся заново; вход сохраняется.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["slack"]
    },
    {
      "id": "gpu.directx.shadercache",
      "ruleVersion": 1,
      "title_ru": "Кэш шейдеров DirectX",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\D3DSCache"] },
      "targets": [{ "root": "%LOCALAPPDATA%\\D3DSCache", "include": ["**"] }],
      "action": "delete",
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Игры заново соберут шейдеры; первые запуски могут подтормаживать.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["d3dscache"]
    },
    {
      "id": "gpu.nvidia.shadercache",
      "ruleVersion": 1,
      "title_ru": "Кэш шейдеров NVIDIA",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\NVIDIA"] },
      "targets": [{ "root": "%LOCALAPPDATA%\\NVIDIA", "include": ["DXCache\\**", "GLCache\\**", "OptixCache\\**"] }],
      "action": "delete",
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Игры заново соберут шейдеры; первые запуски могут подтормаживать.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["nvidia-cache"]
    },
    {
      "id": "gpu.amd.shadercache",
      "ruleVersion": 1,
      "title_ru": "Кэш шейдеров AMD",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\AMD"] },
      "targets": [{ "root": "%LOCALAPPDATA%\\AMD", "include": ["DxCache\\**", "DxcCache\\**", "VkCache\\**", "GLCache\\**"] }],
      "action": "delete",
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Игры заново соберут шейдеры; первые запуски могут подтормаживать.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["amd-cache"]
    },
    {
      "id": "windows.explorer.thumbcache",
      "ruleVersion": 1,
      "title_ru": "Кэш эскизов Проводника",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer"] },
      "targets": [{ "root": "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer", "include": ["thumbcache_*.db", "iconcache_*.db"] }],
      "action": "handler:Thumbnail Cache",
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Проводник заново построит эскизы; папки с фото первое время будут открываться медленнее.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["thumbcache"]
    },
    {
      "id": "windows.user.crashdumps",
      "ruleVersion": 1,
      "title_ru": "Дампы падений программ",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\CrashDumps"] },
      "targets": [{ "root": "%LOCALAPPDATA%\\CrashDumps", "include": ["*.dmp"], "minAgeDays": 3 }],
      "action": "delete",
      "riskClass": "caution",
      "consequence": "lost",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": false,
      "sideEffects_ru": "Дампы нужны только для разбора падений разработчиком; после удаления их не восстановить.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["crashdumps"]
    },
    {
      "id": "windows.user.wer",
      "ruleVersion": 1,
      "title_ru": "Отчёты об ошибках Windows",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\Microsoft\\Windows\\WER"] },
      "targets": [{ "root": "%LOCALAPPDATA%\\Microsoft\\Windows\\WER", "include": ["ReportArchive\\**", "ReportQueue\\**"], "minAgeDays": 3 }],
      "action": "delete",
      "riskClass": "caution",
      "consequence": "lost",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": false,
      "sideEffects_ru": "Неотправленные отчёты об ошибках не уйдут в Microsoft; на работу системы не влияет.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["wer"]
    },
    {
      "id": "windows.system.minidump",
      "ruleVersion": 1,
      "title_ru": "Малые дампы памяти после сбоев",
      "detect": { "anyPath": ["%SYSTEMROOT%\\Minidump"] },
      "targets": [{ "root": "%SYSTEMROOT%\\Minidump", "include": ["*.dmp"], "minAgeDays": 7 }],
      "action": "delete",
      "riskClass": "caution",
      "consequence": "lost",
      "reversible": false,
      "requiresAdmin": true,
      "automationEligible": false,
      "sideEffects_ru": "Дампы нужны для разбора синих экранов; после удаления их не восстановить. Нужны права администратора.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["minidump"]
    },
