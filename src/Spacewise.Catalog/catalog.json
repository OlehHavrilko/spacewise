{
  "version": 1,
  "rules": [
    {
      "id": "windows.user.temp",
      "ruleVersion": 1,
      "title_ru": "Временные файлы пользователя",
      "detect": { "anyPath": ["%TEMP%"] },
      "targets": [{ "root": "%TEMP%", "include": ["**"], "minAgeDays": 1 }],
      "action": "delete",
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Удаляются файлы старше суток; занятые файлы пропускаются.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["user-temp"]
    },
    {
      "id": "windows.system.temp",
      "ruleVersion": 1,
      "title_ru": "Временные файлы Windows",
      "detect": { "anyPath": ["%SYSTEMROOT%\\Temp"] },
      "targets": [{ "root": "%SYSTEMROOT%\\Temp", "include": ["**"], "minAgeDays": 7 }],
      "action": "delete",
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": true,
      "automationEligible": false,
      "sideEffects_ru": "Удаляются файлы старше недели. Нужны права администратора.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["system-temp"]
    },
    {
      "id": "browser.chromium.chrome.cache",
      "ruleVersion": 1,
      "title_ru": "Кэш Google Chrome",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\Google\\Chrome\\User Data"] },
      "profiles": { "root": "%LOCALAPPDATA%\\Google\\Chrome\\User Data", "include": ["Default", "Profile *"] },
      "targets": [{ "root": "{profile}", "include": ["Cache\\Cache_Data\\**", "Code Cache\\**", "GPUCache\\**"] }],
      "action": "delete",
      "runningProcess": ["chrome.exe"],
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Браузер создаст кэш заново; первые загрузки сайтов будут дольше.",
      "verifiedOn": { "os": ["10.0.26300"], "app": ">=120" },
      "fixtures": ["chromium-profile"]
    },
    {
      "id": "browser.chromium.edge.cache",
      "ruleVersion": 1,
      "title_ru": "Кэш Microsoft Edge",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\Microsoft\\Edge\\User Data"] },
      "profiles": { "root": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data", "include": ["Default", "Profile *"] },
      "targets": [{ "root": "{profile}", "include": ["Cache\\Cache_Data\\**", "Code Cache\\**", "GPUCache\\**"] }],
      "action": "delete",
      "runningProcess": ["msedge.exe"],
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Браузер создаст кэш заново; первые загрузки сайтов будут дольше.",
      "verifiedOn": { "os": ["10.0.26300"], "app": ">=120" },
      "fixtures": ["edge-profile"]
    },
    {
      "id": "browser.chromium.brave.cache",
      "ruleVersion": 1,
      "title_ru": "Кэш Brave",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data"] },
      "profiles": { "root": "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data", "include": ["Default", "Profile *"] },
      "targets": [{ "root": "{profile}", "include": ["Cache\\Cache_Data\\**", "Code Cache\\**", "GPUCache\\**"] }],
      "action": "delete",
      "runningProcess": ["brave.exe"],
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Браузер создаст кэш заново; первые загрузки сайтов будут дольше.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["brave-profile"]
    },
    {
      "id": "browser.firefox.cache",
      "ruleVersion": 1,
      "title_ru": "Кэш Firefox",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles"] },
      "profiles": { "root": "%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles", "include": ["*"] },
      "targets": [{ "root": "{profile}", "include": ["cache2\\**", "startupCache\\**"] }],
      "action": "delete",
      "runningProcess": ["firefox.exe"],
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Браузер создаст кэш заново; закладки, пароли и история не затрагиваются.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["firefox-profile"]
    },
    {
      "id": "electron.discord.cache",
      "ruleVersion": 1,
      "title_ru": "Кэш Discord",
      "detect": { "anyPath": ["%APPDATA%\\discord"] },
      "targets": [{ "root": "%APPDATA%\\discord", "include": ["Cache\\**", "Code Cache\\**", "GPUCache\\**"] }],
      "action": "delete",
      "runningProcess": ["Discord.exe"],
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Картинки и вложения загрузятся заново; вход и настройки сохраняются.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["discord"]
    },
    {
      "id": "electron.vscode.cache",
      "ruleVersion": 1,
      "title_ru": "Кэш Visual Studio Code",
      "detect": { "anyPath": ["%APPDATA%\\Code"] },
      "targets": [{ "root": "%APPDATA%\\Code", "include": ["Cache\\**", "CachedData\\**", "Code Cache\\**", "GPUCache\\**"] }],
      "action": "delete",
      "runningProcess": ["Code.exe"],
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Первый запуск после очистки будет медленнее; расширения и настройки не затрагиваются.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["vscode"]
    },
    {
      "id": "electron.slack.cache",
      "ruleVersion": 1,
      "title_ru": "Кэш Slack",
      "detect": { "anyPath": ["%APPDATA%\\Slack"] },
      "targets": [{ "root": "%APPDATA%\\Slack", "include": ["Cache\\**", "Code Cache\\**", "GPUCache\\**", "Service Worker\\CacheStorage\\**"] }],
      "action": "delete",
      "runningProcess": ["slack.exe"],
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Картинки и файлы загрузятся заново; вход сохраняется.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["slack"]
    },
    {
      "id": "gpu.directx.shadercache",
      "ruleVersion": 1,
      "title_ru": "Кэш шейдеров DirectX",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\D3DSCache"] },
      "targets": [{ "root": "%LOCALAPPDATA%\\D3DSCache", "include": ["**"] }],
      "action": "delete",
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Игры заново соберут шейдеры; первые запуски могут подтормаживать.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["d3dscache"]
    },
    {
      "id": "gpu.nvidia.shadercache",
      "ruleVersion": 1,
      "title_ru": "Кэш шейдеров NVIDIA",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\NVIDIA"] },
      "targets": [{ "root": "%LOCALAPPDATA%\\NVIDIA", "include": ["DXCache\\**", "GLCache\\**", "OptixCache\\**"] }],
      "action": "delete",
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Игры заново соберут шейдеры; первые запуски могут подтормаживать.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["nvidia-cache"]
    },
    {
      "id": "gpu.amd.shadercache",
      "ruleVersion": 1,
      "title_ru": "Кэш шейдеров AMD",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\AMD"] },
      "targets": [{ "root": "%LOCALAPPDATA%\\AMD", "include": ["DxCache\\**", "DxcCache\\**", "VkCache\\**", "GLCache\\**"] }],
      "action": "delete",
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Игры заново соберут шейдеры; первые запуски могут подтормаживать.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["amd-cache"]
    },
    {
      "id": "windows.explorer.thumbcache",
      "ruleVersion": 1,
      "title_ru": "Кэш эскизов Проводника",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer"] },
      "targets": [{ "root": "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer", "include": ["thumbcache_*.db", "iconcache_*.db"] }],
      "action": "handler:Thumbnail Cache",
      "riskClass": "safe",
      "consequence": "regenerated",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": true,
      "sideEffects_ru": "Проводник заново построит эскизы; папки с фото первое время будут открываться медленнее.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["thumbcache"]
    },
    {
      "id": "windows.user.crashdumps",
      "ruleVersion": 1,
      "title_ru": "Дампы падений программ",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\CrashDumps"] },
      "targets": [{ "root": "%LOCALAPPDATA%\\CrashDumps", "include": ["*.dmp"], "minAgeDays": 3 }],
      "action": "delete",
      "riskClass": "caution",
      "consequence": "lost",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": false,
      "sideEffects_ru": "Дампы нужны только для разбора падений разработчиком; после удаления их не восстановить.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["crashdumps"]
    },
    {
      "id": "windows.user.wer",
      "ruleVersion": 1,
      "title_ru": "Отчёты об ошибках Windows",
      "detect": { "anyPath": ["%LOCALAPPDATA%\\Microsoft\\Windows\\WER"] },
      "targets": [{ "root": "%LOCALAPPDATA%\\Microsoft\\Windows\\WER", "include": ["ReportArchive\\**", "ReportQueue\\**"], "minAgeDays": 3 }],
      "action": "delete",
      "riskClass": "caution",
      "consequence": "lost",
      "reversible": false,
      "requiresAdmin": false,
      "automationEligible": false,
      "sideEffects_ru": "Неотправленные отчёты об ошибках не уйдут в Microsoft; на работу системы не влияет.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["wer"]
    },
    {
      "id": "windows.system.minidump",
      "ruleVersion": 1,
      "title_ru": "Малые дампы памяти после сбоев",
      "detect": { "anyPath": ["%SYSTEMROOT%\\Minidump"] },
      "targets": [{ "root": "%SYSTEMROOT%\\Minidump", "include": ["*.dmp"], "minAgeDays": 7 }],
      "action": "delete",
      "riskClass": "caution",
      "consequence": "lost",
      "reversible": false,
      "requiresAdmin": true,
      "automationEligible": false,
      "sideEffects_ru": "Дампы нужны для разбора синих экранов; после удаления их не восстановить. Нужны права администратора.",
      "verifiedOn": { "os": ["10.0.26300"] },
      "fixtures": ["minidump"]
    },
    {"id": "browser.chromium.vivaldi.cache", "ruleVersion": 1, "title_ru": "Кэш Vivaldi", "detect": {"anyPath": ["%LOCALAPPDATA%\\Vivaldi\\User Data"]}, "profiles": {"root": "%LOCALAPPDATA%\\Vivaldi\\User Data", "include": ["Default", "Profile *"]}, "targets": [{"root": "{profile}", "include": ["Cache\\Cache_Data\\**", "Code Cache\\**", "GPUCache\\**"]}], "action": "delete", "runningProcess": ["vivaldi.exe"], "riskClass": "safe", "consequence": "regenerated", "reversible": false, "requiresAdmin": false, "automationEligible": true, "sideEffects_ru": "Браузер создаст кэш заново; первые загрузки сайтов будут дольше.", "verifiedOn": {"os": ["10.0.26300"]}, "fixtures": ["vivaldi-profile"]},
    {"id": "browser.opera.cache", "ruleVersion": 1, "title_ru": "Кэш Opera", "detect": {"anyPath": ["%LOCALAPPDATA%\\Opera Software\\Opera Stable"]}, "targets": [{"root": "%LOCALAPPDATA%\\Opera Software\\Opera Stable", "include": ["Cache\\Cache_Data\\**", "GPUCache\\**"]}], "action": "delete", "runningProcess": ["opera.exe"], "riskClass": "safe", "consequence": "regenerated", "reversible": false, "requiresAdmin": false, "automationEligible": true, "sideEffects_ru": "Браузер создаст кэш заново; первые загрузки сайтов будут дольше.", "verifiedOn": {"os": ["10.0.26300"]}, "fixtures": ["opera"]},
    {"id": "electron.teams.classic.cache", "ruleVersion": 1, "title_ru": "Кэш Microsoft Teams (классический)", "detect": {"anyPath": ["%APPDATA%\\Microsoft\\Teams"]}, "targets": [{"root": "%APPDATA%\\Microsoft\\Teams", "include": ["Cache\\**", "Code Cache\\**", "GPUCache\\**", "Service Worker\\CacheStorage\\**"]}], "action": "delete", "runningProcess": ["Teams.exe"], "riskClass": "safe", "consequence": "regenerated", "reversible": false, "requiresAdmin": false, "automationEligible": true, "sideEffects_ru": "Картинки и файлы загрузятся заново; вход и чаты сохраняются.", "verifiedOn": {"os": ["10.0.26300"]}, "fixtures": ["teams-classic"]},
    {"id": "app.spotify.cache", "ruleVersion": 1, "title_ru": "Кэш Spotify", "detect": {"anyPath": ["%LOCALAPPDATA%\\Spotify"]}, "targets": [{"root": "%LOCALAPPDATA%\\Spotify", "include": ["Data\\**", "Storage\\**"]}], "action": "delete", "runningProcess": ["Spotify.exe"], "riskClass": "safe", "consequence": "redownloaded", "reversible": false, "requiresAdmin": false, "automationEligible": true, "sideEffects_ru": "Музыка из кэша загрузится заново; плейлисты и загрузки для офлайна не затрагиваются.", "verifiedOn": {"os": ["10.0.26300"]}, "fixtures": ["spotify"]},
    {"id": "windows.user.inetcache", "ruleVersion": 1, "title_ru": "Кэш интернета Windows (INetCache)", "detect": {"anyPath": ["%LOCALAPPDATA%\\Microsoft\\Windows\\INetCache"]}, "targets": [{"root": "%LOCALAPPDATA%\\Microsoft\\Windows\\INetCache", "include": ["IE\\**", "Low\\IE\\**"]}], "action": "delete", "riskClass": "safe", "consequence": "regenerated", "reversible": false, "requiresAdmin": false, "automationEligible": true, "sideEffects_ru": "Кэш встроенных веб-компонентов создастся заново.", "verifiedOn": {"os": ["10.0.26300"]}, "fixtures": ["inetcache"]},
    {"id": "gpu.intel.shadercache", "ruleVersion": 1, "title_ru": "Кэш шейдеров Intel", "detect": {"anyPath": ["%LOCALAPPDATA%\\Intel"]}, "targets": [{"root": "%LOCALAPPDATA%\\Intel", "include": ["ShaderCache\\**"]}], "action": "delete", "riskClass": "safe", "consequence": "regenerated", "reversible": false, "requiresAdmin": false, "automationEligible": true, "sideEffects_ru": "Игры заново соберут шейдеры; первые запуски могут подтормаживать.", "verifiedOn": {"os": ["10.0.26300"]}, "fixtures": ["intel-cache"]},
    {"id": "dev.npm.cache", "ruleVersion": 1, "title_ru": "Кэш npm", "detect": {"anyPath": ["%LOCALAPPDATA%\\npm-cache"]}, "targets": [{"root": "%LOCALAPPDATA%\\npm-cache", "include": ["_cacache\\**"]}], "action": "delete", "runningProcess": ["node.exe"], "riskClass": "safe", "consequence": "redownloaded", "reversible": false, "requiresAdmin": false, "automationEligible": true, "sideEffects_ru": "Пакеты скачаются заново при следующей установке.", "verifiedOn": {"os": ["10.0.26300"]}, "fixtures": ["npm"]},
    {"id": "dev.pip.cache", "ruleVersion": 1, "title_ru": "Кэш pip", "detect": {"anyPath": ["%LOCALAPPDATA%\\pip"]}, "targets": [{"root": "%LOCALAPPDATA%\\pip", "include": ["Cache\\**"]}], "action": "delete", "runningProcess": ["python.exe", "pip.exe"], "riskClass": "safe", "consequence": "redownloaded", "reversible": false, "requiresAdmin": false, "automationEligible": true, "sideEffects_ru": "Пакеты Python скачаются заново при следующей установке.", "verifiedOn": {"os": ["10.0.26300"]}, "fixtures": ["pip"]},
    {"id": "dev.nuget.httpcache", "ruleVersion": 1, "title_ru": "HTTP-кэш NuGet", "detect": {"anyPath": ["%LOCALAPPDATA%\\NuGet"]}, "targets": [{"root": "%LOCALAPPDATA%\\NuGet", "include": ["v3-cache\\**", "plugins-cache\\**"]}], "action": "delete", "runningProcess": ["dotnet.exe", "devenv.exe"], "riskClass": "safe", "consequence": "redownloaded", "reversible": false, "requiresAdmin": false, "automationEligible": true, "sideEffects_ru": "Метаданные пакетов скачаются заново; установленные пакеты (.nuget\\packages) не затрагиваются.", "verifiedOn": {"os": ["10.0.26300"]}, "fixtures": ["nuget"]},
    {"id": "dev.yarn.cache", "ruleVersion": 1, "title_ru": "Кэш Yarn", "detect": {"anyPath": ["%LOCALAPPDATA%\\Yarn"]}, "targets": [{"root": "%LOCALAPPDATA%\\Yarn", "include": ["Cache\\**"]}], "action": "delete", "runningProcess": ["node.exe"], "riskClass": "safe", "consequence": "redownloaded", "reversible": false, "requiresAdmin": false, "automationEligible": true, "sideEffects_ru": "Пакеты скачаются заново при следующей установке.", "verifiedOn": {"os": ["10.0.26300"]}, "fixtures": ["yarn"]}

  ]
}
