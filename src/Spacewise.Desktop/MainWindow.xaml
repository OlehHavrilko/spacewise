<Window x:Class="Spacewise.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Spacewise" Width="1220" Height="820" MinWidth="640" MinHeight="420"
 FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
 Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
 WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visible" /></Window.Resources>
 <Grid Margin="12" Background="{DynamicResource CanvasBrush}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <DockPanel Margin="4,0,4,10">
   <TextBlock DockPanel.Dock="Left" Text="Spacewise" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
   <Expander DockPanel.Dock="Right" Header="{DynamicResource Ui.002}" MaxWidth="560" Margin="12,0,0,0"
    Visibility="{Binding ShowWelcome, Converter={StaticResource Visible}}" HorizontalAlignment="Right">
    <StackPanel>
     <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock Text="{DynamicResource Ui.003}" TextWrapping="Wrap" /></ScrollViewer>
     <Button Content="{DynamicResource Ui.004}" Command="{Binding DismissWelcomeCommand}" HorizontalAlignment="Right" />
    </StackPanel>
   </Expander>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <ListBox x:Name="Navigation" AutomationProperties.Name="{DynamicResource Ui.071}"
    Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
    BorderThickness="0" Margin="0,0,10,0" SelectedValuePath="Content"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
      <Setter Property="Template">
       <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="Chrome" CornerRadius="8" Background="{DynamicResource CanvasBrush}" Padding="{TemplateBinding Padding}"
          BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
          <ContentPresenter />
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True">
           <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentBrush}" />
           <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
           <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
           <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
          </Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate>
       </Setter.Value>
      </Setter>
     </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate>
     <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border Grid.Column="1" Style="{StaticResource CardBorder}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
     <ContentControl Content="{Binding SelectedValue, ElementName=Navigation}" MinHeight="440"
      Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
    </ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10" Margin="0,10,0,0">
   <StackPanel>
    <WrapPanel>
     <Button Content="{DynamicResource Ui.011}" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,6,4" />
     <Button Content="{DynamicResource Ui.013}" Command="{Binding PreviewCleanupCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,6,4" />
     <Button Content="{DynamicResource Ui.015}" Style="{StaticResource DestructiveButton}" Command="{Binding CleanCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,6,4" />
     <Button Content="{DynamicResource Ui.012}" Command="{Binding ScanCancelCommand}" Style="{StaticResource QuietButton}"
      Visibility="{Binding ScanCommand.IsRunning, Converter={StaticResource Visible}}" />
     <Button Content="{DynamicResource Ui.014}" Command="{Binding PreviewCleanupCancelCommand}" Style="{StaticResource QuietButton}"
      Visibility="{Binding PreviewCleanupCommand.IsRunning, Converter={StaticResource Visible}}" />
     <Button Content="{DynamicResource Ui.016}" Command="{Binding CleanCancelCommand}" Style="{StaticResource QuietButton}"
      Visibility="{Binding CleanCommand.IsRunning, Converter={StaticResource Visible}}" />
    </WrapPanel>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Margin="0,6,0,0" />
   </StackPanel>
  </Border>
  <Expander Grid.Row="3" Header="{DynamicResource Ui.064}" Margin="4,6,4,0">
   <TextBox Text="{Binding Details, Mode=OneWay}" MaxHeight="90" IsReadOnly="True" TextWrapping="Wrap"
    VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Ui.064}" />
  </Expander>
 </Grid>
</Window>
