<UserControl x:Class="Spacewise.Desktop.Views.DisksView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible" /></UserControl.Resources>

        <DockPanel Margin="18">
          <TextBlock DockPanel.Dock="Top"
                     Text="{Binding DisksStatus}"
                     Foreground="{DynamicResource MutedBrush}"
                     Margin="0,0,0,12"
                     TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
          <DataGrid ItemsSource="{Binding Disks}"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    AutomationProperties.Name="{DynamicResource Ui.038}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource Ui.039}" Binding="{Binding Name, Mode=OneWay}" Width="70" />
              <DataGridTextColumn Header="{DynamicResource Ui.040}" Binding="{Binding Label, Mode=OneWay}" Width="140" />
              <DataGridTextColumn Header="{DynamicResource Ui.041}" Binding="{Binding FileSystem, Mode=OneWay}" Width="90" />
              <DataGridTextColumn Header="{DynamicResource Ui.042}" Binding="{Binding Total, Mode=OneWay}" Width="110" />
              <DataGridTextColumn Header="{DynamicResource Ui.043}" Binding="{Binding Free, Mode=OneWay}" Width="110" />
              <DataGridTextColumn Header="{DynamicResource Ui.044}" Binding="{Binding Used, Mode=OneWay}" Width="100" />
              <DataGridTextColumn Header="{DynamicResource Ui.045}" Binding="{Binding Forecast, Mode=OneWay}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>

</UserControl>
