<Window x:Class="Spacewise.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Spacewise.Desktop"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="Spacewise"
        Width="1220"
        Height="820"
        MinWidth="960"
        MinHeight="680"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentBrush}">
        <TextBlock Text="S"
                   Foreground="{DynamicResource AccentTextBrush}"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
        <TextBlock Text="Spacewise" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="{DynamicResource Ui.068}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
      </StackPanel>
      <Border Grid.Column="2"
              CornerRadius="18"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="1"
              Padding="12,7"
              VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{DynamicResource Ui.069}"
                     Foreground="{DynamicResource MutedBrush}"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1"
            Style="{StaticResource CardBorder}"
            Padding="18"
            Margin="0,0,0,14"
            Visibility="{Binding ShowWelcome, Converter={StaticResource Visible}}"
            AutomationProperties.Name="{DynamicResource Ui.001}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{DynamicResource Ui.002}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource Ui.003}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     Margin="0,5,20,0" />
        </StackPanel>
        <Button Grid.Column="1"
                Content="{DynamicResource Ui.004}"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding DismissWelcomeCommand}"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Ui.007}" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Ui.070}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
          </StackPanel>
          <TextBox x:Name="RootPath"
                   Grid.Column="1"
                   Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding IsIdle}"
                   VerticalContentAlignment="Center"
                   AutomationProperties.Name="{DynamicResource Ui.007}" />
          <Button Grid.Column="2"
                  Content="{DynamicResource Ui.008}"
                  Style="{StaticResource PrimaryButton}"
                  Margin="8,0,0,0"
                  Click="Browse_Click" />
        </Grid>

        <Expander Grid.Row="1" Header="{DynamicResource Ui.066}" Margin="0,12,0,0">
          <StackPanel Margin="0,10,0,0">
            <TextBlock Text="{DynamicResource Ui.009}"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="12"
                       Margin="0,0,0,6" />
            <TextBox x:Name="Exclusions"
                     Text="{Binding ExclusionsText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsIdle}"
                     Height="68"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="{DynamicResource Ui.010}" />
          </StackPanel>
        </Expander>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel>
          <Button Content="{DynamicResource Ui.011}"
                  Style="{StaticResource PrimaryButton}"
                  Margin="0,0,8,6"
                  Command="{Binding ScanCommand}"
                  IsEnabled="{Binding IsIdle}" />
          <Button Content="{DynamicResource Ui.013}"
                  Margin="0,0,8,6"
                  Command="{Binding PreviewCleanupCommand}"
                  IsEnabled="{Binding IsIdle}" />
          <Button Content="{DynamicResource Ui.015}"
                  Style="{StaticResource DestructiveButton}"
                  Margin="0,0,8,6"
                  Command="{Binding CleanCommand}"
                  IsEnabled="{Binding IsIdle}" />
          <Button Content="{DynamicResource Ui.012}"
                  Style="{StaticResource QuietButton}"
                  Margin="0,0,4,6"
                  Command="{Binding ScanCancelCommand}" />
          <Button Content="{DynamicResource Ui.014}"
                  Style="{StaticResource QuietButton}"
                  Margin="0,0,4,6"
                  Command="{Binding PreviewCleanupCancelCommand}" />
          <Button Content="{DynamicResource Ui.016}"
                  Style="{StaticResource QuietButton}"
                  Margin="0,0,4,6"
                  Command="{Binding CleanCancelCommand}" />
        </WrapPanel>

        <Grid Grid.Row="1" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Status}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding RootsSummary}"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
          </StackPanel>
          <ProgressBar Grid.Column="1"
                       IsIndeterminate="True"
                       Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
        </Grid>

        <Expander Grid.Row="2" Header="{DynamicResource Ui.067}" Margin="0,12,0,0">
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding QuarantineStatus}"
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="1"
                    Content="{DynamicResource Ui.017}"
                    Margin="8,0,0,0"
                    Command="{Binding RestoreCommand}"
                    IsEnabled="{Binding IsIdle}" />
            <Button Grid.Column="2"
                    Content="{DynamicResource Ui.018}"
                    Margin="8,0,0,0"
                    Command="{Binding PurgeCommand}"
                    IsEnabled="{Binding IsIdle}" />
          </Grid>
        </Expander>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="4" Height="520" Margin="0,0,0,14">
      <TabItem Header="{DynamicResource Ui.019}" AutomationProperties.Name="{DynamicResource Ui.019}">
        <DockPanel Margin="18">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Ui.020}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Ui.072}"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="12"
                       Margin="0,3,0,0" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding Files}"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    EnableRowVirtualization="True"
                    AutomationProperties.Name="{DynamicResource Ui.020}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource Ui.021}" Binding="{Binding Path}" Width="*" />
              <DataGridTextColumn Header="{DynamicResource Ui.022}" Binding="{Binding Size}" Width="110" />
              <DataGridTextColumn Header="{DynamicResource Ui.023}" Binding="{Binding OnDisk}" Width="110" />
              <DataGridTextColumn Header="{DynamicResource Ui.024}" Binding="{Binding Note}" Width="210" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="{DynamicResource Ui.025}" AutomationProperties.Name="{DynamicResource Ui.025}">
        <DockPanel Margin="18">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Ui.025}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CleanupStatus}"
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="{DynamicResource Ui.026}"
                      Padding="10,5"
                      Command="{Binding SelectAllCommand}" />
              <Button Content="{DynamicResource Ui.027}"
                      Padding="10,5"
                      Margin="8,0,0,0"
                      Command="{Binding SelectNoneCommand}" />
              <TextBlock Text="{Binding SelectionSummary}"
                         Foreground="{DynamicResource MutedBrush}"
                         Margin="16,0,0,0"
                         VerticalAlignment="Center"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </StackPanel>
          <DataGrid ItemsSource="{Binding Cleanup}"
                    IsReadOnly="False"
                    RowDetailsVisibilityMode="VisibleWhenSelected"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    AutomationProperties.Name="{DynamicResource Ui.028}">
            <DataGrid.RowDetailsTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Explanation}"
                           Margin="24,8,12,12"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{DynamicResource Ui.029}" />
              </DataTemplate>
            </DataGrid.RowDetailsTemplate>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{DynamicResource Ui.030}" Width="64">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanSelect}"
                              AutomationProperties.Name="{DynamicResource Ui.031}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn IsReadOnly="True" Header="{DynamicResource Ui.032}" Binding="{Binding Title, Mode=OneWay}" Width="190" />
              <DataGridTextColumn IsReadOnly="True" Header="{DynamicResource Ui.033}" Binding="{Binding Files, Mode=OneWay}" Width="76" />
              <DataGridTextColumn IsReadOnly="True" Header="{DynamicResource Ui.034}" Binding="{Binding Estimate, Mode=OneWay}" Width="100" />
              <DataGridTextColumn IsReadOnly="True" Header="{DynamicResource Ui.035}" Binding="{Binding Consequence, Mode=OneWay}" Width="150" />
              <DataGridTextColumn IsReadOnly="True" Header="{DynamicResource Ui.036}" Binding="{Binding SideEffects, Mode=OneWay}" Width="*" />
              <DataGridTextColumn IsReadOnly="True" Header="{DynamicResource Ui.024}" Binding="{Binding Note, Mode=OneWay}" Width="190" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="{DynamicResource Ui.037}" AutomationProperties.Name="{DynamicResource Ui.037}">
        <DockPanel Margin="18">
          <TextBlock DockPanel.Dock="Top"
                     Text="{Binding DisksStatus}"
                     Foreground="{DynamicResource MutedBrush}"
                     Margin="0,0,0,12"
                     TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
          <DataGrid ItemsSource="{Binding Disks}"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    AutomationProperties.Name="{DynamicResource Ui.038}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource Ui.039}" Binding="{Binding Name, Mode=OneWay}" Width="70" />
              <DataGridTextColumn Header="{DynamicResource Ui.040}" Binding="{Binding Label, Mode=OneWay}" Width="140" />
              <DataGridTextColumn Header="{DynamicResource Ui.041}" Binding="{Binding FileSystem, Mode=OneWay}" Width="90" />
              <DataGridTextColumn Header="{DynamicResource Ui.042}" Binding="{Binding Total, Mode=OneWay}" Width="110" />
              <DataGridTextColumn Header="{DynamicResource Ui.043}" Binding="{Binding Free, Mode=OneWay}" Width="110" />
              <DataGridTextColumn Header="{DynamicResource Ui.044}" Binding="{Binding Used, Mode=OneWay}" Width="100" />
              <DataGridTextColumn Header="{DynamicResource Ui.045}" Binding="{Binding Forecast, Mode=OneWay}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="{DynamicResource Ui.046}" AutomationProperties.Name="{DynamicResource Ui.046}">
        <DockPanel Margin="18">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
              <Button Content="{DynamicResource Ui.047}"
                      Style="{StaticResource PrimaryButton}"
                      Command="{Binding LoadUsageCommand}" />
              <Button Content="{DynamicResource Ui.048}"
                      Margin="8,0,0,0"
                      Command="{Binding EraseHistoryCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding UsageStatus}"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding UsageSummary}"
                       Margin="0,4,0,0"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding UsageRows}"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    EnableRowVirtualization="True"
                    AutomationProperties.Name="{DynamicResource Ui.049}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource Ui.050}" Binding="{Binding Name, Mode=OneWay}" Width="220" />
              <DataGridTextColumn Header="{DynamicResource Ui.051}" Binding="{Binding Kind, Mode=OneWay}" Width="100" />
              <DataGridTextColumn Header="{DynamicResource Ui.022}" Binding="{Binding SizeText, Mode=OneWay}" Width="110" />
              <DataGridTextColumn Header="{DynamicResource Ui.046}" Binding="{Binding Status, Mode=OneWay}" Width="*" />
              <DataGridTextColumn Header="{DynamicResource Ui.052}" Binding="{Binding Evidence, Mode=OneWay}" Width="220" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="{DynamicResource Ui.053}" AutomationProperties.Name="{DynamicResource Ui.053}">
        <DockPanel Margin="18">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <WrapPanel>
              <Button Content="{DynamicResource Ui.054}" Command="{Binding RefreshHistoryCommand}" />
              <Button Content="{DynamicResource Ui.055}"
                      Margin="8,0,0,0"
                      Command="{Binding VerifyJournalCommand}" />
              <Button Content="{DynamicResource Ui.056}"
                      Margin="8,0,0,0"
                      Command="{Binding ExportReportCommand}" />
              <CheckBox Content="{DynamicResource Ui.057}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding ExportIncludesPaths}" />
              <Button Content="{DynamicResource Ui.058}"
                      Margin="8,0,0,0"
                      Command="{Binding ExportDiagnosticsCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding HistoryStatus}"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding History}"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    EnableRowVirtualization="True"
                    AutomationProperties.Name="{DynamicResource Ui.059}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource Ui.060}" Binding="{Binding Time, Mode=OneWay}" Width="140" />
              <DataGridTextColumn Header="{DynamicResource Ui.061}" Binding="{Binding Action, Mode=OneWay}" Width="210" />
              <DataGridTextColumn Header="{DynamicResource Ui.062}" Binding="{Binding Result, Mode=OneWay}" Width="190" />
              <DataGridTextColumn Header="{DynamicResource Ui.022}" Binding="{Binding Size, Mode=OneWay}" Width="100" />
              <DataGridTextColumn Header="{DynamicResource Ui.063}" Binding="{Binding Path, Mode=OneWay}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="{DynamicResource Settings.Tab}" AutomationProperties.Name="{DynamicResource Settings.Tab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Settings.Title}" FontSize="20" FontWeight="SemiBold" />

            <TextBlock Text="{DynamicResource Settings.AppearanceHeader}" FontWeight="SemiBold" Margin="0,22,0,8" />
            <TextBlock Text="{DynamicResource Settings.ThemeLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
            <ComboBox SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" Width="240" HorizontalAlignment="Left"
                      AutomationProperties.Name="{DynamicResource Settings.ThemeLabel}">
              <ComboBoxItem Content="{DynamicResource Settings.ThemeSystem}" />
              <ComboBoxItem Content="{DynamicResource Settings.ThemeLight}" />
              <ComboBoxItem Content="{DynamicResource Settings.ThemeDark}" />
            </ComboBox>
            <TextBlock Text="{DynamicResource Settings.ThemeNote}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />

            <TextBlock Text="{DynamicResource Settings.DataHeader}" FontWeight="SemiBold" Margin="0,26,0,8" />
            <TextBlock Text="{Binding DataFolder}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Settings.DataNote}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,10" />
            <StackPanel Orientation="Horizontal">
              <Button Content="{DynamicResource Settings.OpenData}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
              <Button Content="{DynamicResource Settings.OpenLogs}" Command="{Binding OpenLogsFolderCommand}" />
            </StackPanel>

            <TextBlock Text="{DynamicResource Settings.AboutHeader}" FontWeight="SemiBold" Margin="0,26,0,8" />
            <TextBlock Text="{Binding AppVersion, StringFormat={}Spacewise {0}}" />
            <TextBlock Text="{DynamicResource Settings.License}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="5" Style="{StaticResource CardBorder}" Padding="14">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="{DynamicResource Ui.064}"
                   Foreground="{DynamicResource MutedBrush}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5" />
        <TextBox Text="{Binding Details, Mode=OneWay}"
                 Height="58"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0"
                 AutomationProperties.Name="{DynamicResource Ui.064}" />
      </DockPanel>
    </Border>
  </Grid>
  </ScrollViewer>
</Window>
